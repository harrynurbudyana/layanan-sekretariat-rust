DATABASE_URL="sqlite://data/dev.db"
DATABASE_ROOMS_URL="sqlite://data/rooms.db"
PORT=8088

# Konfigurasi Google OAuth / Identity Services
# Dapatkan Client ID dari Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# Akun yang mendapatkan hak staf sekretariat (admin penuh)
ADMIN_EMAILS=sekretariat@tass.telkomuniversity.ac.id

# Konfigurasi Notifikasi Email (SMTP)
# Contoh untuk Gmail / Google Workspace:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=emailanda@tass.telkomuniversity.ac.id
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx  # 16 karakter App Password dari Akun Google
# SMTP_FROM="Layanan Sekretariat FIT <emailanda@tass.telkomuniversity.ac.id>"
# SMTP_ADMIN_EMAIL=sekretariat@tass.telkomuniversity.ac.id
# SMTP_ENABLED=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Layanan Sekretariat FIT <e-office@tass.telkomuniversity.ac.id>"
SMTP_ADMIN_EMAIL=sekretariat@tass.telkomuniversity.ac.id
SMTP_ENABLED=true
